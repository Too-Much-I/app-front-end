{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/code-review/cli.mjs\" hook",
            "timeout": 10,
            "statusMessage": "코드 리뷰 세션 안내"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/code-review/cli.mjs\" hook",
            "timeout": 210,
            "statusMessage": "구현 검사와 리뷰 준비"
          }
        ]
      }
    ]
  }
}
