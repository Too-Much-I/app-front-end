# 로컬 개발 전용 예시다. EAS cloud build는 이 파일 대신 profile과 같은 이름의
# EAS Environment를 사용한다. EXPO_PUBLIC_* 값은 앱 번들에 포함되는 공개 설정이다.
EXPO_PUBLIC_IDENTITY_API_BASE_URL=https://identity-test.to-teacher.com
EXPO_PUBLIC_LEARNING_API_BASE_URL=https://api-staging.to-teacher.com
EXPO_PUBLIC_WEB_BASE_URL=https://to-teacher.com
EXPO_PUBLIC_ENABLE_CLARITY=false
EXPO_PUBLIC_ENABLE_SENTRY=false
EXPO_PUBLIC_ENABLE_AMPLITUDE=false

# Amplitude 프로젝트별 client API key. 공개 값이지만 프로젝트가 곧 환경이므로
# development/preview/production EAS Environment마다 다른 값을 넣어야 데이터가 섞이지 않는다.
# 키가 비어 있으면 플래그가 켜져 있어도 초기화하지 않는다.
EXPO_PUBLIC_AMPLITUDE_API_KEY=

# 소스맵·디버그 심볼 업로드용 빌드 타임 토큰. 번들에 실리면 안 되므로 EXPO_PUBLIC_ 접두사를 붙이지 않는다.
# 실제 값은 로컬의 추적되지 않는 .env.local 또는 EAS의 secret 환경변수로만 관리한다.
SENTRY_AUTH_TOKEN=

# 개발 빌드에서 로그인·가입 UI만 확인. 실제 인증/문자 발송/Guest 생성은 실행하지 않는다.
EXPO_PUBLIC_AUTH_UI_PREVIEW=false

# Firebase native 설정 파일 경로. EAS에서는 file 환경변수로 등록한다.
# 로컬에서 생략하면 config/firebase/의 두 설정 파일을 사용한다.
# GOOGLE_SERVICES_IOS=/absolute/path/GoogleService-Info.plist
# GOOGLE_SERVICES_ANDROID=/absolute/path/google-services.json

# OAuth client ID / Provider ID는 공개 설정이다. Client Secret은 앱에 넣지 않는다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_KAKAO_OIDC_PROVIDER_ID=
EXPO_PUBLIC_FIREBASE_APPLE_ENABLED=false
