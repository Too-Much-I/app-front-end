<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram id="feature-map" name="Feature map">
    <mxGraphModel dx="1740" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="토선생 앱 · Feature map — 기능이 무엇을 소유하고, 어디에 기대는가" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#111827;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1100" height="30" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="박스 하나 = 기능 하나. 각 박스는 [API] [매퍼] [훅·모듈] [소유 화면] 순서로 읽는다. 빨간 점선 = 정리하면 좋을 결합." style="text;html=1;fontSize=13;fontColor=#6B7280;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="1200" height="20" as="geometry" /></mxCell>

        <mxCell id="fm_auth" value="&lt;b style=&quot;font-size:15px&quot;&gt;auth — 신원과 게이트&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;API&lt;/b&gt;　create-guest · reissue-tokens · logout&lt;br&gt;　　　　get-consent-status · update-consents&lt;br&gt;&lt;b&gt;검증&lt;/b&gt;　types.ts — parseRawTokenPair · isAuthSession&lt;br&gt;&lt;b&gt;모듈&lt;/b&gt;　&lt;b&gt;auth-controller (821줄, 싱글턴 상태기계)&lt;/b&gt;&lt;br&gt;　　　　AuthProvider · auth-context (useSyncExternalStore)&lt;br&gt;　　　　auth-session-storage(SecureStore) · installation-id&lt;br&gt;&lt;b&gt;화면&lt;/b&gt;　ConsentScreen · AuthRecoveryScreen&lt;br&gt;&lt;br&gt;&lt;i&gt;상태: CHECKING_LOCAL / CONSENT_REQUIRED / REISSUING /&lt;br&gt;CHECKING_SERVER_CONSENT / GUEST_RECOVERING /&lt;br&gt;CONSENT_UPDATING / AUTHENTICATED / RETRYABLE_ERROR&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F2;strokeColor=#F76910;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="390" height="270" as="geometry" /></mxCell>

        <mxCell id="fm_exam" value="&lt;b style=&quot;font-size:15px&quot;&gt;exam — 모의고사 · 채점 · 피드백 · 재답변&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;API 11&lt;/b&gt;　session-create · question-info/status · answer-upload-url&lt;br&gt;　　　　answer-submit · grading-status/summary/retry · history · retries&lt;br&gt;&lt;b&gt;매퍼 7&lt;/b&gt;　map-exam-session · -question-info · -question-feedback&lt;br&gt;　　　　-grading-result · -history · -retries · -table-context&lt;br&gt;&lt;b&gt;훅 6&lt;/b&gt;　use-answer-recorder · use-answer-submissions(518줄)&lt;br&gt;　　　　use-grading-status · use-reanswer-question/-submission&lt;br&gt;　　　　use-feedback-data-refresh&lt;br&gt;&lt;b&gt;도메인&lt;/b&gt;　part-meta · part-directions · part-guide · part-prelude&lt;br&gt;　　　　exam-cue · question-audio · ready-notice · level-estimate&lt;br&gt;&lt;b&gt;웹뷰 계약&lt;/b&gt;　native-data-bridge · reanswer-message · go-home-message&lt;br&gt;　　　　feedback-data-ready · feedback-history · summary-retry(+폴링)&lt;br&gt;&lt;b&gt;화면&lt;/b&gt;　mock-exam 6 · Feedback · ExamHistory · Reanswer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEDF9;strokeColor=#0E5A7D;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="470" y="90" width="600" height="270" as="geometry" /></mxCell>

        <mxCell id="fm_audio" value="&lt;b style=&quot;font-size:15px&quot;&gt;audio — 시간제한 녹음&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;훅&lt;/b&gt;　use-timed-audio-recorder (566줄)&lt;br&gt;　　제네릭 context를 받아 녹음 1건에 붙인다&lt;br&gt;　　status · elapsed · remaining · metering&lt;br&gt;　　start / finish / discard / resetForRetry&lt;br&gt;　　transferOwnership / dispose&lt;br&gt;&lt;b&gt;모듈&lt;/b&gt;　audio-session (재생·녹음 모드 프리셋)&lt;br&gt;　　recording-file (존재·크기 검증, 삭제)&lt;br&gt;　　recording-permission (Android 16 회피)&lt;br&gt;&lt;br&gt;&lt;i&gt;화면을 소유하지 않는다. 두 도메인이&lt;br&gt;각자 어댑터로 감싸 쓴다.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1100" y="90" width="590" height="270" as="geometry" /></mxCell>

        <mxCell id="fm_chal" value="&lt;b style=&quot;font-size:15px&quot;&gt;challenge — 10초 챌린지&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;API 6&lt;/b&gt;　challenge-today · -today-question · -attempt&lt;br&gt;　　　　-upload-url · -answer · -day-result&lt;br&gt;&lt;b&gt;매퍼&lt;/b&gt;　리소스별 6파일 + epoch-ms (2026-08-31 분리)&lt;br&gt;&lt;b&gt;훅 5&lt;/b&gt;　use-challenge-question · -attempt · -recorder&lt;br&gt;　　　　-submission · -result(폴링 2s→5s, 예산 180s)&lt;br&gt;&lt;b&gt;도메인&lt;/b&gt;　challenge-error-codes (서버 코드 → 앱 분기)&lt;br&gt;&lt;b&gt;개발용&lt;/b&gt;　&lt;font color=&quot;#B91C1C&quot;&gt;dev-mock-challenge + __DEV__ 분기 4곳&lt;/font&gt;&lt;br&gt;&lt;b&gt;화면&lt;/b&gt;　TenSecondChallengeScreen · ChallengeResultScreen&lt;br&gt;　　　　components 13개 (노트 · 종이 장식 3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7F2;strokeColor=#BD4900;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="50" y="400" width="600" height="230" as="geometry" /></mxCell>

        <mxCell id="fm_consent" value="&lt;b style=&quot;font-size:15px&quot;&gt;consent — 동의 기록&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;consent-storage — 필수 2종 · 버전 · 동의 시각&lt;br&gt;optional-consent-storage — 품질 검토&lt;br&gt;　null(미선택)과 false(거부)를 구분한다&lt;br&gt;&lt;br&gt;저장은 AsyncStorage. 서버 상태가 정본이고&lt;br&gt;로컬은 화면 표시용 사본이다.&lt;br&gt;&lt;br&gt;&lt;i&gt;화면 없음 — auth와 settings가 쓴다.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F2;strokeColor=#F76910;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="680" y="400" width="390" height="230" as="geometry" /></mxCell>

        <mxCell id="fm_orient" value="&lt;b style=&quot;font-size:15px&quot;&gt;orientation — 화면 방향&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;use-landscape-detection — 가속도 센서로 자세 판정&lt;br&gt;OrientationProvider / orientation-context&lt;br&gt;&lt;br&gt;앱은 세로 고정이지만 Part 4 표만 가로를 허용한다.&lt;br&gt;그 외에서 기기를 돌리면 PortraitOnlyNotice가&lt;br&gt;NavigationContainer 바깥에서 전체를 덮는다.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1100" y="400" width="590" height="110" as="geometry" /></mxCell>

        <mxCell id="fm_diag" value="&lt;b style=&quot;font-size:15px&quot;&gt;diagnostics — Sentry 검증&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sentry-validation-catalog — 스크러빙 정책이 실제로 도는지 개발 빌드에서 확인하는 합성 이벤트 카탈로그.&lt;br&gt;별도 앱 루트(SentryValidationScreen)로 들어가며 운영 빌드에는 켜지지 않는다.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1100" y="530" width="590" height="100" as="geometry" /></mxCell>

        <mxCell id="dbt_title" value="정리하면 좋을 것들 — 지금은 안 아프지만 다음 기능에서 아프다" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#B91C1C;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="680" width="900" height="24" as="geometry" /></mxCell>

        <mxCell id="d1" value="&lt;b&gt;① 화면 폴더가 도메인 상태를 소유&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;screens/mock-exam/hooks/exam-session-store.ts (296줄, phase 17종)&lt;br&gt;screens/challenge/challenge-ui.ts (249줄, 첨삭 정규화까지)&lt;br&gt;screens/reanswer/reanswer-ui.ts&lt;br&gt;→ AGENTS.md는 도메인 로직을 features에 두라고 한다.&lt;br&gt;→ 챌린지 스테이지 화면을 만들면 challenge-ui를 그 화면도 써야 한다.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#EF4444;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="50" y="715" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="d2" value="&lt;b&gt;② challenge → exam 직접 참조&lt;/b&gt; — 남아 있음&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;use-challenge-submission이 features/exam/upload-answer-audio에서&lt;br&gt;uploadAnswerAudio · getValidAnswerAudioFile · AnswerAudioUploadError ·&lt;br&gt;ANSWER_AUDIO_CONTENT_TYPE 네 개를 가져온다.&lt;br&gt;→ 이름은 &quot;answer(시험 답변)&quot;인데 챌린지가 쓴다.&lt;br&gt;→ 이름이 아니라 파일을 옮기는 일이라 이름 정리에서 제외했다.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#EF4444;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="470" y="715" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="d3" value="&lt;b&gt;③ 이름 겹침&lt;/b&gt; — &lt;font color=&quot;#0E5A7D&quot;&gt;2026-08-31 해소&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;동명 함수 3쌍 → 도메인 접두로 분리&lt;br&gt;두 상수 → CHALLENGE_RECORDING_DURATION_MS / _SEC 한 자리&lt;br&gt;껍데기 재수출 3건 → 삭제&lt;br&gt;&lt;b&gt;pnpm check:naming&lt;/b&gt;이 CI에서 재발을 막는다&lt;br&gt;남은 것: formatCountdown ≡ formatDuration (의미의 문제라 기계가 못 잡음)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#EF4444;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="890" y="715" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="d4" value="&lt;b&gt;④ 폴링·백오프가 세 곳에 각자&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;use-grading-status (시험 채점)&lt;br&gt;use-challenge-result (챌린지 AI)&lt;br&gt;summary-feedback-retry-polling (종합 피드백 재생성)&lt;br&gt;→ 주기 · 예산 · 취소 · &quot;한 번은 성공했는가&quot; 판정이 각각 다르게 구현됨.&lt;br&gt;→ 서버 상태 계층(react-query)이 비어 있어서 생긴 반복.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F0;strokeColor=#EF4444;fontSize=13;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1310" y="715" width="380" height="150" as="geometry" /></mxCell>

        <mxCell id="d5" value="&lt;b&gt;⑤ 껍데기 재수출 — 2026-08-31 해소&lt;/b&gt;　세 건(features/exam/recording-permission.ts · answer-audio.ts · use-answer-recorder.ts의 AnswerRecordingError 별칭)을 지우고 소비처를 features/audio의 원본 모듈로 돌렸다. check:naming의 aliased-re-export 규칙이 재발을 막는다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#ECE2CF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="50" y="885" width="1640" height="50" as="geometry" /></mxCell>
        <mxCell id="d6" value="&lt;b&gt;⑥ 검증되지 않는 순수 함수들&lt;/b&gt;　테스트 러너가 없다. 매퍼 7 + findCorrectionSpans + resolveChallengeUiStatus + scaleForWidth + decidePartPrelude + summarizeReanswerProgress + normalizeCorrectionSeverity 등 &quot;입력 → 출력&quot;만 있는 함수가 40개 이상인데, CI는 lint와 typecheck만 돈다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#ECE2CF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="50" y="945" width="1640" height="50" as="geometry" /></mxCell>

        <mxCell id="fe1" value="공용 녹음 훅을 어댑터로 감싼다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#374151;fontSize=11;fontColor=#374151;" edge="1" parent="1" source="fm_exam" target="fm_audio"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe2" value="같은 훅, 다른 어댑터" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#374151;fontSize=11;fontColor=#374151;" edge="1" parent="1" source="fm_chal" target="fm_audio"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3" value="업로드 경로를 빌려 쓴다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#EF4444;dashed=1;fontSize=11;fontColor=#B91C1C;" edge="1" parent="1" source="fm_chal" target="fm_exam"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4" value="동의 기록 읽기·쓰기" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F76910;fontSize=11;fontColor=#BD4900;" edge="1" parent="1" source="fm_auth" target="fm_consent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe5" value="모든 인증 요청이 통과한다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F76910;fontSize=11;fontColor=#BD4900;" edge="1" parent="1" source="fm_exam" target="fm_auth"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
